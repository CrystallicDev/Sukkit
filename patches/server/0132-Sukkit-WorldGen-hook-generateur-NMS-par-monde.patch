diff --git a/src/main/java/org/bukkit/craftbukkit/generator/SukkitChunkGenerator.java b/src/main/java/org/bukkit/craftbukkit/generator/SukkitChunkGenerator.java
new file mode 100644
index 0000000000000000000000000000000000000000..bf20f8e69950767a55353dde551e2d649c5b6370
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/generator/SukkitChunkGenerator.java
@@ -0,0 +1,110 @@
+package org.bukkit.craftbukkit.generator;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+import net.minecraft.server.*;
+
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.generator.BlockPopulator;
+
+/**
+ * Sukkit - WorldGen.
+ * <p>
+ * Adaptateur {@link InternalChunkGenerator} déléguant à un {@link IChunkProvider}
+ * NMS arbitraire fourni par un plugin via
+ * {@link org.bukkit.craftbukkit.worldgen.NmsWorldGenRegistry}. Même rôle que
+ * {@link NormalChunkGenerator}, mais pour un provider custom.
+ */
+public class SukkitChunkGenerator extends InternalChunkGenerator {
+    private final IChunkProvider provider;
+
+    public SukkitChunkGenerator(IChunkProvider provider) {
+        this.provider = provider;
+    }
+
+    @Override
+    public byte[] generate(org.bukkit.World world, Random random, int x, int z) {
+        throw new UnsupportedOperationException("Not supported.");
+    }
+
+    @Override
+    public boolean canSpawn(org.bukkit.World world, int x, int z) {
+        return ((CraftWorld) world).getHandle().worldProvider.canSpawn(x, z);
+    }
+
+    @Override
+    public List<BlockPopulator> getDefaultPopulators(org.bukkit.World world) {
+        return new ArrayList<BlockPopulator>();
+    }
+
+    @Override
+    public boolean isChunkLoaded(int i, int i1) {
+        return provider.isChunkLoaded(i, i1);
+    }
+
+    @Override
+    public Chunk getOrCreateChunk(int i, int i1) {
+        return provider.getOrCreateChunk(i, i1);
+    }
+
+    @Override
+    public Chunk getChunkAt(BlockPosition blockPosition) {
+        return provider.getChunkAt(blockPosition);
+    }
+
+    @Override
+    public void getChunkAt(IChunkProvider icp, int i, int i1) {
+        provider.getChunkAt(icp, i, i1);
+    }
+
+    @Override
+    public boolean a(IChunkProvider iChunkProvider, Chunk chunk, int i, int i1) {
+        return provider.a(provider, chunk, i, i1);
+    }
+
+    @Override
+    public boolean saveChunks(boolean bln, IProgressUpdate ipu) {
+        return provider.saveChunks(bln, ipu);
+    }
+
+    @Override
+    public boolean unloadChunks() {
+        return provider.unloadChunks();
+    }
+
+    @Override
+    public boolean canSave() {
+        return provider.canSave();
+    }
+
+    @Override
+    public List<BiomeBase.BiomeMeta> getMobsFor(EnumCreatureType ect, BlockPosition position) {
+        return provider.getMobsFor(ect, position);
+    }
+
+    @Override
+    public BlockPosition findNearestMapFeature(World world, String string, BlockPosition position) {
+        return provider.findNearestMapFeature(world, string, position);
+    }
+
+    // n.m.s implementations always return 0. (The true implementation is in ChunkProviderServer)
+    @Override
+    public int getLoadedChunks() {
+        return 0;
+    }
+
+    @Override
+    public void recreateStructures(Chunk chunk, int i, int i1) {
+        provider.recreateStructures(chunk, i, i1);
+    }
+
+    @Override
+    public String getName() {
+        return provider.getName();
+    }
+
+    @Override
+    public void c() {}
+}
diff --git a/src/main/java/org/bukkit/craftbukkit/worldgen/NmsWorldGenRegistry.java b/src/main/java/org/bukkit/craftbukkit/worldgen/NmsWorldGenRegistry.java
new file mode 100644
index 0000000000000000000000000000000000000000..33acdd8ae3e9e8a845326f90082dd771463ed1d7
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/worldgen/NmsWorldGenRegistry.java
@@ -0,0 +1,49 @@
+package org.bukkit.craftbukkit.worldgen;
+
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Sukkit - WorldGen.
+ * <p>
+ * Registre des générateurs NMS custom, indexés par nom de monde (insensible à la
+ * casse). Thread-safe ; la résolution est faite sur le thread principal lors de la
+ * création du monde ({@code WorldServer.k()} et {@code WorldProvider.b()}).
+ */
+public final class NmsWorldGenRegistry {
+
+    private static final Map<String, NmsWorldGenerator> GENERATORS = new ConcurrentHashMap<>();
+
+    private NmsWorldGenRegistry() {}
+
+    /**
+     * Enregistre un générateur pour un monde. À appeler avant la création du monde.
+     * Écrase un enregistrement précédent pour le même nom.
+     */
+    public static void register(String worldName, NmsWorldGenerator generator) {
+        if (worldName == null) throw new IllegalArgumentException("worldName is null");
+        if (generator == null) throw new IllegalArgumentException("generator is null");
+        GENERATORS.put(key(worldName), generator);
+    }
+
+    /**
+     * Retire l'enregistrement d'un monde. Sans effet sur un monde déjà créé.
+     */
+    public static void unregister(String worldName) {
+        if (worldName != null) {
+            GENERATORS.remove(key(worldName));
+        }
+    }
+
+    /**
+     * @return le générateur enregistré pour ce monde, ou {@code null}
+     */
+    public static NmsWorldGenerator get(String worldName) {
+        return worldName == null ? null : GENERATORS.get(key(worldName));
+    }
+
+    private static String key(String name) {
+        return name.toLowerCase(Locale.ROOT);
+    }
+}
diff --git a/src/main/java/org/bukkit/craftbukkit/worldgen/NmsWorldGenerator.java b/src/main/java/org/bukkit/craftbukkit/worldgen/NmsWorldGenerator.java
new file mode 100644
index 0000000000000000000000000000000000000000..56456b1f17e5ac3f969523497695a802de76e1ac
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/worldgen/NmsWorldGenerator.java
@@ -0,0 +1,37 @@
+package org.bukkit.craftbukkit.worldgen;
+
+import net.minecraft.server.IChunkProvider;
+import net.minecraft.server.World;
+import net.minecraft.server.WorldChunkManager;
+import net.minecraft.server.WorldServer;
+
+/**
+ * Sukkit - WorldGen.
+ * <p>
+ * Générateur NMS complet fourni par un plugin pour un monde donné, sans passer
+ * par l'API Bukkit {@link org.bukkit.generator.ChunkGenerator} (trop limitée :
+ * pas de biomes custom, pas de contrôle des carvers ni de la décoration).
+ * <p>
+ * Doit être enregistré via {@link NmsWorldGenRegistry#register(String, NmsWorldGenerator)}
+ * <b>avant</b> la création du monde ({@code WorldCreator#createWorld()}). Le monde
+ * principal étant chargé avant les plugins, seuls les mondes secondaires peuvent
+ * utiliser ce hook.
+ */
+public interface NmsWorldGenerator {
+
+    /**
+     * Crée le fournisseur de chunks (terrain, carvers, décoration) du monde.
+     * Appelé une seule fois, sur le thread principal, à l'initialisation du monde.
+     */
+    IChunkProvider createChunkProvider(WorldServer world);
+
+    /**
+     * Crée le gestionnaire de biomes (placement des biomes) du monde.
+     * Appelé une seule fois, avant {@link #createChunkProvider(WorldServer)}.
+     *
+     * @return le WorldChunkManager custom, ou {@code null} pour conserver le vanilla
+     */
+    default WorldChunkManager createWorldChunkManager(World world) {
+        return null;
+    }
+}
