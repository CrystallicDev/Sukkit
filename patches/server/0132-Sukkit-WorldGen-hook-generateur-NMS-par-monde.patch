+        org.bukkit.craftbukkit.worldgen.NmsWorldGenerator sukkitGenerator = org.bukkit.craftbukkit.worldgen.NmsWorldGenRegistry.get(this.b.getWorldData().getName());
+        if (sukkitGenerator != null) {
+            WorldChunkManager sukkitManager = sukkitGenerator.createWorldChunkManager(this.b);
+            if (sukkitManager != null) {
+                this.c = sukkitManager;
+                return;
+            }
+        }
+        // Sukkit end
         WorldType worldtype = this.b.getWorldData().getType();
 
         if (worldtype == WorldType.FLAT) {
