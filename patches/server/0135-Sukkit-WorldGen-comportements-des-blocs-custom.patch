diff --git a/src/main/java/org/bukkit/craftbukkit/worldgen/CustomBlockBehaviors.java b/src/main/java/org/bukkit/craftbukkit/worldgen/CustomBlockBehaviors.java
new file mode 100644
index 0000000000000000000000000000000000000000..86a9c19948c5ce6cbcd780dd52101f4a9cc8862c
--- /dev/null
+++ b/src/main/java/org/bukkit/craftbukkit/worldgen/CustomBlockBehaviors.java
@@ -0,0 +1,104 @@
+package org.bukkit.craftbukkit.worldgen;
+
+import net.minecraft.server.Block;
+import net.minecraft.server.IBlockData;
+import net.minecraft.server.ItemStack;
+
+import java.util.Arrays;
+
+/**
+ * Sukkit - WorldGen.
+ * <p>
+ * Comportements des "blocs custom" (états valides d'un bloc vanilla réutilisés
+ * avec un rendu OptiFine différent) : un plugin enregistre ses états
+ * (id, meta) pour :
+ * <ul>
+ * <li>les protéger du pop de plante (BlockPlant.e — une fleur-hôte custom peut
+ *     alors tenir sur n'importe quel support, s'empiler, pendre d'un plafond) ;</li>
+ * <li>contrôler les drops (défaut vanilla / rien / item placeholder global) ;</li>
+ * <li>remapper l'effet de casse (particules + son, world event 2001) vers un
+ *     autre bloc — le son de pas reste client-side, non remappable sans mod.</li>
+ * </ul>
+ * Coût nul quand aucun état n'est enregistré. Enregistrement à l'enable des
+ * plugins (main thread), lecture seule ensuite.
+ */
+public final class CustomBlockBehaviors {
+
+    public static final int DROPS_DEFAULT = 0;
+    public static final int DROPS_NONE = 1;
+    public static final int DROPS_PLACEHOLDER = 2;
+
+    /** Modes d'attache (pop de plante) : voir {@link #getAttachMode}. */
+    public static final int ATTACH_NONE = 0;    // comportement vanilla
+    public static final int ATTACH_ANY = 1;     // ne pop jamais
+    public static final int ATTACH_CEILING = 2; // exige un bloc solide au-dessus
+    public static final int ATTACH_FLOOR = 3;   // exige un bloc solide en-dessous
+
+    // index = id << 4 | meta (12 bits)
+    private static final byte[] DROPS = new byte[4096];
+    private static final byte[] ATTACH = new byte[4096];
+    private static final int[] BREAK_EFFECT = new int[4096];
+    private static volatile boolean active = false;
+    private static ItemStack placeholderDrop;
+
+    static {
+        Arrays.fill(BREAK_EFFECT, -1);
+    }
+
+    private CustomBlockBehaviors() {}
+
+    /**
+     * Enregistre un état custom.
+     *
+     * @param dropsMode  DROPS_DEFAULT / DROPS_NONE / DROPS_PLACEHOLDER
+     * @param attachMode ATTACH_ANY (jamais de pop) / ATTACH_CEILING (pop sauf
+     *                   solide au-dessus) / ATTACH_FLOOR / ATTACH_NONE (vanilla)
+     */
+    public static void register(int blockId, int meta, int dropsMode, int attachMode) {
+        int index = combined(blockId, meta);
+        DROPS[index] = (byte) dropsMode;
+        ATTACH[index] = (byte) attachMode;
+        active = true;
+    }
+
+    /** Effet de casse (particules + son) affiché comme celui d'un autre bloc. */
+    public static void setBreakEffect(int blockId, int meta, int effectBlockId, int effectMeta) {
+        BREAK_EFFECT[combined(blockId, meta)] = effectBlockId + (effectMeta << 12); // format event 2001
+        active = true;
+    }
+
+    /** Item droppé par les états en mode DROPS_PLACEHOLDER (null = rien). */
+    public static void setPlaceholderDrop(ItemStack itemStack) {
+        placeholderDrop = itemStack;
+    }
+
+    public static int getAttachMode(IBlockData state) {
+        return active ? ATTACH[combined(state)] : ATTACH_NONE;
+    }
+
+    public static int getDropsMode(IBlockData state) {
+        return active ? DROPS[combined(state)] : DROPS_DEFAULT;
+    }
+
+    public static ItemStack getPlaceholderDrop() {
+        return placeholderDrop;
+    }
+
+    /** Remap de la data du world event 2001 (id + meta&lt;&lt;12). Identité si non enregistré. */
+    public static int remapBreakEffect(int data) {
+        if (!active) {
+            return data;
+        }
+        int remapped = BREAK_EFFECT[((data & 4095) << 4 | (data >> 12) & 15) & 4095];
+        return remapped >= 0 ? remapped : data;
+    }
+
+    private static int combined(IBlockData state) {
+        Block block = state.getBlock();
+        return combined(Block.getId(block), block.toLegacyData(state));
+    }
+
+    private static int combined(int blockId, int meta) {
+        return (blockId << 4 | (meta & 15)) & 4095;
+    }
+}
